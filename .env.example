# Hosted dashboard secrets. Generate strong random values; never commit real ones.
INGEST_TOKEN=replace-with-at-least-32-random-bytes
VIEW_TOKEN=replace-with-a-separate-random-view-code

# Local collector configuration (normally stored in ~/.usage-hub/env).
KIMI_CODE_API_KEY=
KIMI_CODE_BASE_URL=https://api.kimi.com
# Optional documented API adapters. Leave blank to keep them disabled.
OPENAI_ADMIN_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GITHUB_COPILOT_USERNAME=
GITHUB_COPILOT_TOKEN=
GITHUB_COPILOT_MONTHLY_CREDIT_LIMIT=
# Optional explicit comma-separated provider IDs. By default, configured
# optional adapters are auto-enabled alongside Codex and Kimi.
USAGE_HUB_PROVIDERS=
USAGE_HUB_PUSH_URL=https://your-dashboard.example/api/ingest
USAGE_HUB_PUSH_TOKEN=replace-with-the-same-ingest-token
USAGE_HUB_CLOUD_URL=https://your-dashboard.example/
USAGE_HUB_VIEW_CODE_FILE=~/.usage-hub/view-code
USAGE_HUB_CODEX_LOG_ESTIMATE=on

# Optional token-equivalent calibration values. Defaults are 10,000,000/week.
USAGE_HUB_CODEX_WEEKLY_TOKEN_CAPACITY=10000000
USAGE_HUB_KIMI_WEEKLY_TOKEN_CAPACITY=10000000
