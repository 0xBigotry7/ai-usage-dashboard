{
  "name": "ai-usage-dashboard",
  "version": "0.8.1",
  "description": "A local-first AI quota, API usage, token, and macOS menu bar dashboard.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xBigotry7/ai-usage-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/0xBigotry7/ai-usage-dashboard/issues"
  },
  "homepage": "https://github.com/0xBigotry7/ai-usage-dashboard#readme",
  "keywords": [
    "ai-usage",
    "codex",
    "kimi-code",
    "provider-adapters",
    "token-dashboard",
    "cloudflare-workers"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "collector": "node --enable-source-maps collector/server.mjs",
    "local": "node scripts/run-local.mjs",
    "configure:kimi": "node scripts/configure-kimi.mjs",
    "configure:provider": "node scripts/configure-provider.mjs",
    "configure:capacity": "node scripts/configure-token-capacity.mjs",
    "menubar": "swift run --package-path apps/macos-menu-bar UsageMenuBar",
    "build:menubar": "node scripts/build-menu-bar.mjs",
    "configure:cloud": "node scripts/configure-cloud-sync.mjs",
    "generate:cloud-secrets": "node scripts/generate-cloud-secrets.mjs",
    "copy:view-code": "node scripts/copy-view-code.mjs",
    "test": "node --experimental-strip-types --test tests/collector.test.mjs tests/session-log-estimate.test.mjs tests/provider-http.test.mjs tests/configure-token-capacity.test.mjs && npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@cloudflare/workers-types": "^5.20260723.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.1.5",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.0"
  },
  "type": "module"
}
