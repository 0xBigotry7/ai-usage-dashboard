# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Local hosting identity. Copy the example when using OpenAI Sites.
/.openai/hosting.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/dist/
/prebuilt/
/.wrangler/
/outputs/
/work/
/apps/macos-menu-bar/.build/

# Private provider overlays and machine-specific collectors.
/.private/
